    //5. write down trigger on opportunity that ensure that account cannot have opportunity if total sum of opp is already greater than equal to 50000


    //trigger OpportunityTrigger on Opportunity (before insert) {        ---------executed

    Set<Id> accIds = new Set<Id>();

    for(Opportunity opp : Trigger.new) {
        if(opp.AccountId != null) {
            accIds.add(opp.AccountId);
        }
    }

    Map<Id, Decimal> accMap = new Map<Id, Decimal>();

    List<AggregateResult> aggList = [
        SELECT AccountId, SUM(Amount) totalAmount
        FROM Opportunity
        WHERE AccountId IN :accIds
        GROUP BY AccountId
    ];

    for(AggregateResult agg : aggList) {

        Id accId = (Id)agg.get('AccountId');

        Decimal total = (Decimal)agg.get('totalAmount');

        accMap.put(accId, total);
    }

    for(Opportunity opp : Trigger.new) {

        if(accMap.get(opp.AccountId)>=50000) {

            
      opp.addError('Account cannot have an Opportunity because total Amount is already greater than or equal to 50000.');
